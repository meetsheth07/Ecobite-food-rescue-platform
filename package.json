{
  "name": "ecobite",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev --prefix server\" \"npm:dev --prefix client\"",
    "build": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "check": "npm run check --prefix server && npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
